{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string"
    },
    "transcript_path": {
      "type": "string"
    },
    "cwd": {
      "type": "string"
    },
    "hook_event_name": {
      "type": "string",
      "const": "SubagentStop"
    },
    "prompt_id": {
      "type": "string"
    },
    "scratchpad_dir": {
      "type": "string"
    },
    "permission_mode": {
      "type": "string"
    },
    "effort": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string"
        }
      },
      "required": [
        "level"
      ],
      "additionalProperties": {}
    },
    "agent_id": {
      "type": "string"
    },
    "agent_type": {
      "type": "string"
    },
    "stop_hook_active": {
      "type": "boolean"
    },
    "agent_transcript_path": {
      "type": "string"
    },
    "last_assistant_message": {
      "type": "string"
    },
    "background_tasks": {
      "type": "array",
      "items": {}
    },
    "session_crons": {
      "type": "array",
      "items": {}
    }
  },
  "required": [
    "session_id",
    "transcript_path",
    "cwd",
    "hook_event_name",
    "agent_id",
    "agent_type",
    "stop_hook_active",
    "agent_transcript_path"
  ],
  "additionalProperties": {}
}
