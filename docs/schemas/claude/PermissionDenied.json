{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string"
    },
    "transcript_path": {
      "type": "string"
    },
    "cwd": {
      "type": "string"
    },
    "hook_event_name": {
      "type": "string",
      "const": "PermissionDenied"
    },
    "prompt_id": {
      "type": "string"
    },
    "scratchpad_dir": {
      "type": "string"
    },
    "permission_mode": {
      "type": "string"
    },
    "effort": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string"
        }
      },
      "required": [
        "level"
      ],
      "additionalProperties": {}
    },
    "agent_id": {
      "type": "string"
    },
    "agent_type": {
      "type": "string"
    },
    "tool_name": {
      "type": "string"
    },
    "tool_input": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "tool_use_id": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "transcript_path",
    "cwd",
    "hook_event_name",
    "tool_name",
    "tool_input",
    "tool_use_id",
    "reason"
  ],
  "additionalProperties": {}
}
