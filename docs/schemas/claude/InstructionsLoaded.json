{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string"
    },
    "transcript_path": {
      "type": "string"
    },
    "cwd": {
      "type": "string"
    },
    "hook_event_name": {
      "type": "string",
      "const": "InstructionsLoaded"
    },
    "prompt_id": {
      "type": "string"
    },
    "scratchpad_dir": {
      "type": "string"
    },
    "permission_mode": {
      "type": "string",
      "enum": [
        "default",
        "plan",
        "acceptEdits",
        "auto",
        "dontAsk",
        "bypassPermissions"
      ]
    },
    "effort": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string"
        }
      },
      "required": [
        "level"
      ],
      "additionalProperties": {}
    },
    "agent_id": {
      "type": "string"
    },
    "agent_type": {
      "type": "string"
    },
    "file_path": {
      "type": "string"
    },
    "memory_type": {
      "type": "string",
      "enum": [
        "Project"
      ]
    },
    "load_reason": {
      "type": "string",
      "enum": [
        "include",
        "nested_traversal",
        "path_glob_match",
        "session_start"
      ]
    },
    "globs": {
      "type": "array",
      "items": {}
    },
    "parent_file_path": {
      "type": "string"
    },
    "trigger_file_path": {
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "transcript_path",
    "cwd",
    "hook_event_name",
    "file_path",
    "memory_type",
    "load_reason"
  ],
  "additionalProperties": {}
}
