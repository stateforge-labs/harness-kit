{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string"
    },
    "transcript_path": {
      "type": "string"
    },
    "cwd": {
      "type": "string"
    },
    "hook_event_name": {
      "type": "string",
      "const": "PostModelSwitch"
    },
    "prompt_id": {
      "type": "string"
    },
    "scratchpad_dir": {
      "type": "string"
    },
    "permission_mode": {
      "type": "string"
    },
    "effort": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string"
        }
      },
      "required": [
        "level"
      ],
      "additionalProperties": {}
    },
    "agent_id": {
      "type": "string"
    },
    "agent_type": {
      "type": "string"
    },
    "from_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "to_model": {
      "type": "string"
    },
    "requested_model": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "context_tokens": {
      "type": "number"
    },
    "prompt_cache_warm": {
      "type": "boolean"
    },
    "cache_ttl": {
      "type": "string"
    },
    "estimated_cache_write_usd": {
      "type": "number"
    },
    "pricing": {
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "transcript_path",
    "cwd",
    "hook_event_name",
    "from_model",
    "to_model",
    "requested_model",
    "source",
    "context_tokens",
    "prompt_cache_warm",
    "cache_ttl",
    "estimated_cache_write_usd",
    "pricing"
  ],
  "additionalProperties": {}
}
