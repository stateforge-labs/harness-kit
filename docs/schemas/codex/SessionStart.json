{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "cwd": {
      "type": "string"
    },
    "hook_event_name": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "transcript_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "model": {
      "type": "string"
    },
    "permission_mode": {
      "type": "string",
      "enum": [
        "default",
        "acceptEdits",
        "plan",
        "dontAsk",
        "bypassPermissions"
      ]
    },
    "source": {
      "type": "string",
      "enum": [
        "startup",
        "resume",
        "clear",
        "compact",
        "fork"
      ]
    }
  },
  "required": [
    "cwd",
    "hook_event_name",
    "session_id",
    "transcript_path",
    "model",
    "permission_mode",
    "source"
  ],
  "additionalProperties": {}
}
