{
  "name": "@stateforge-labs/harness-hooks",
  "version": "0.1.0",
  "type": "module",
  "description": "Neutral hook events and replies, per-harness decode/encode for Claude Code, Codex and OpenCode, and the middleware pipeline.",
  "license": "MIT",
  "keywords": [
    "claude-code",
    "codex",
    "opencode",
    "hooks",
    "coding-agent",
    "middleware",
    "zod"
  ],
  "homepage": "https://github.com/stateforge-labs/harness-kit/tree/main/packages/hooks#readme",
  "bugs": {
    "url": "https://github.com/stateforge-labs/harness-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stateforge-labs/harness-kit.git",
    "directory": "packages/hooks"
  },
  "author": "stateforge-labs",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./shim": {
      "bun": "./clients/shim/hook-shim.ts",
      "types": "./dist/clients/shim/hook-shim.d.ts",
      "default": "./dist/clients/shim/hook-shim.js"
    },
    "./opencode-plugin": {
      "bun": "./clients/opencode/plugin.ts",
      "types": "./dist/clients/opencode/plugin.d.ts",
      "default": "./dist/clients/opencode/plugin.js"
    },
    "./fixtures/*": "./fixtures/*",
    "./schemas/*": "./schemas/*"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "gen": "bun scripts/gen-registry.ts && bun scripts/gen-json-schema.ts",
    "gen:check": "bun scripts/gen-registry.ts --check && bun scripts/gen-json-schema.ts --check",
    "prepack": "bun run build"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  },
  "files": [
    "src",
    "clients",
    "dist",
    "fixtures",
    "schemas",
    "README.md",
    "LICENSE"
  ]
}
