{
  "name": "@stateforge-labs/harness-adapters",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "description": "Harness knowledge beyond hooks: transcript and store readers, in-flight detection, CLI invocation, usage and context windows, tool facts and TUI chrome for Claude Code, Codex and OpenCode.",
  "keywords": [
    "claude-code",
    "codex",
    "opencode",
    "transcript",
    "coding-agent",
    "zod"
  ],
  "homepage": "https://github.com/stateforge-labs/harness-kit/tree/main/packages/adapters#readme",
  "bugs": {
    "url": "https://github.com/stateforge-labs/harness-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stateforge-labs/harness-kit.git",
    "directory": "packages/adapters"
  },
  "license": "MIT",
  "author": "stateforge-labs",
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    ".": {
      "stateforge-source": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./claude": {
      "stateforge-source": "./src/claude/index.ts",
      "types": "./dist/src/claude/index.d.ts",
      "default": "./dist/src/claude/index.js"
    },
    "./codex": {
      "stateforge-source": "./src/codex/index.ts",
      "types": "./dist/src/codex/index.d.ts",
      "default": "./dist/src/codex/index.js"
    },
    "./opencode": {
      "stateforge-source": "./src/opencode/index.ts",
      "types": "./dist/src/opencode/index.d.ts",
      "default": "./dist/src/opencode/index.js"
    },
    "./opencode/store": {
      "stateforge-source": "./src/opencode/store.ts",
      "types": "./dist/src/opencode/store.d.ts",
      "default": "./dist/src/opencode/store.js"
    },
    "./tui": {
      "stateforge-source": "./src/tui/index.ts",
      "types": "./dist/src/tui/index.d.ts",
      "default": "./dist/src/tui/index.js"
    },
    "./runtime": {
      "stateforge-source": "./src/runtime/index.ts",
      "types": "./dist/src/runtime/index.d.ts",
      "default": "./dist/src/runtime/index.js"
    },
    "./testing": {
      "stateforge-source": "./src/testing/index.ts",
      "types": "./dist/src/testing/index.d.ts",
      "default": "./dist/src/testing/index.js"
    }
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@stateforge-labs/harness-hooks": "^0.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
