/** One scripted engine run: the events to replay, how it ends, an optional pause before each event and an optional extra wait, after the run was cancelled, before \`done\` settles, and the state of the child process tree to report. */
export interface FakeAgentScript {
    readonly events: readonly AgentEvent[];
    readonly result?: Result<AgentOutput, RunFailure>;
    readonly delayMs?: number;
    readonly settleDelayMs?: number;
    readonly tree?: AgentTree;
}
/** An agent engine that replays scripts and records every run input it was given. */
export type FakeAgentEngine<I extends string> = AgentEngineImpl<I> & {
    readonly starts: readonly AgentRunInput[];
};
/** Waits for \`ms\`, or until \`signal\` aborts; resolves true when the wait ran to its end. */
export declare function abortablePause(ms: number, signal: AbortSignal): Promise<boolean>;
/** An agent engine for tests with no model and no binary. Each \`start\` replays the next script; a run past the last script ends with a FAKE-marked unavailable failure. It never emits \`finished\`. */
export declare function fakeAgentEngine<I extends string>(harness: I, scripts: readonly FakeAgentScript[]): FakeAgentEngine<I>;

// testing/fake-claude-query.d.ts
import type { ClaudeQueryOptions } from "../claude/engines/sdk-options.ts";
/** The options the Claude SDK engine hands to its query function. */
export type FakeClaudeQueryOptions = ClaudeQueryOptions;
/** A stream of SDK messages; \`close\` ends it early. */
export interface FakeClaudeQueryStream extends AsyncIterable<unknown> {
    close?(): void;
}
/** One call of the query function: the prompt and the options it received. */
export interface FakeClaudeQueryCall {
    readonly index: number;
    readonly prompt: string;
    readonly options: FakeClaudeQueryOptions;
}
export type FakeClaudeQueryFn = (params: {
    readonly prompt: string;
    readonly options: FakeClaudeQueryOptions;
}) => FakeClaudeQueryStream;
/** A fake query function that records the options of every call and the replies of every hook it invoked. */
export type FakeClaudeQuery = FakeClaudeQueryFn & {
    readonly calls: readonly FakeClaudeQueryOptions[];
    readonly prompts: readonly string[];
    readonly hookReplies: readonly Record<string, unknown>[];
};
/** How a fake query stream behaves between and after its messages. */
export interface FakeClaudeQueryBehaviour {
    readonly delayMs?: number;
    readonly holdOpen?: boolean;
}
/** The messages to replay, or a function that picks them for each call. */
export type FakeClaudeMessages = readonly unknown[] | ((call: FakeClaudeQueryCall) => readonly unknown[]);
type Over = Readonly<Record<string, unknown>>;
interface Usage {
    readonly input?: number;
    readonly cacheWrite?: number;
    readonly cacheRead?: number;
    readonly output?: number;
}
/** SDK-shaped messages, copied in shape from masked captures, plus two directives only the fake understands. */
export declare const claudeMessages: {
    readonly init: (over?: Over) => Record<string, unknown>;
    readonly assistantText: (text?: string, usage?: Usage, over?: Over) => Record<string, unknown>;
    readonly assistantToolUse: (name?: string, input?: Over, usage?: Usage, over?: Over) => Record<string, unknown>;
    readonly toolResult: (toolUseId?: string, content?: string, over?: Over) => Record<string, unknown>;
    readonly resultSuccess: (text?: string, over?: Over) => Record<string, unknown>;
    readonly resultMaxTurns: (over?: Over) => Record<string, unknown>;
    readonly rateLimit: (over?: Over) => Record<string, unknown>;
    readonly hookCall: (event: string, input: Over, toolUseId?: string) => Record<string, unknown>;
    readonly throwError: (message: string, name?: string) => Record<string, unknown>;
};
/** A query function for the Claude SDK engine that yields the given SDK-shaped messages and records the options of every call. After the abort controller aborts, the next pull throws an error named like the SDK's abort error; \`close()\` ends the stream. */
export declare function fakeClaudeQuery(messages: FakeClaudeMessages, behaviour?: FakeClaudeQueryBehaviour): FakeClaudeQuery;
export {};

// testing/fake-transcript-store.d.ts
import type { StoreEntry, TranscriptStore } from "../agent/types.ts";
/** An in-memory transcript store. It applies no dedupe, because dedupe belongs to the consumer. */
export type FakeTranscriptStore = TranscriptStore & {
    readonly entries: ReadonlyMap<string, readonly StoreEntry[]>;
    failNext(): void;
};
/** A transcript store for tests: appends accumulate per key, and \`failNext()\` makes the next append reject once. */
export declare function fakeTranscriptStore(): FakeTranscriptStore;

// testing/scripted-messages-api.d.ts
/** One request the scripted server saw. The key headers are replaced by a fixed marker. */
export interface ScriptedRequest {
    readonly path: string;
    readonly headers: Readonly<Record<string, string>>;
}
/** A running scripted Messages API on 127.0.0.1. */
export interface ScriptedMessagesApi {
    readonly baseUrl: string;
    readonly requests: readonly ScriptedRequest[];
    close(): Promise<void>;
}
/** Token counts for the stream builders below. */
export interface ScriptedUsage {
    readonly input?: number;
    readonly cacheWrite?: number;
    readonly cacheRead?: number;
    readonly output?: number;
}
/** The Messages API stream events of one assistant message that says \`text\` and ends the turn. */
export declare function messagesTextStream(text: string, usage?: ScriptedUsage, model?: string): readonly unknown[];
/** The Messages API stream events of one assistant message that calls a tool and stops for its result. */
export declare function messagesToolUseStream(name: string, input: unknown, usage?: ScriptedUsage, model?: string): readonly unknown[];
/** A local server on 127.0.0.1 that answers POST /v1/messages with the scripted stream as server-sent events. It records the path and headers of every request, with the key headers masked. Node \`http\` only. */
export declare function scriptedMessagesApi(script: readonly unknown[]): Promise<ScriptedMessagesApi>;

// testing/agent-contract.d.ts
import type { AgentEngineImpl, AgentRunInput } from "../agent/engine.ts";
import type { Agent, AgentOptions } from "../agent/types.ts";
import type { RunFailure } from "../core/failure.ts";
import type { Result } from "../core/result.ts";
import type { ContractCheck } from "../driver/contract.ts";
import type { EnvSource } from "../env.ts";
/** The one runtime method the suite needs; any Runtime has it. */
export interface AgentRuntime {
    agent(id: string, options: AgentOptions): Result<Agent, RunFailure>;
}
/** A scenario the suite cannot make up for itself: a runtime wired so the engine behaves as the check needs. */
export interface AgentContractScenario {
    readonly runtime: () => AgentRuntime;
    readonly inputs?: () => readonly AgentRunInput[];
}
/** A scenario in which a hook denies the tool \`tool\`, given as its bare name. */
export interface AgentContractDeny extends AgentContractScenario {
    readonly tool: string;
}
/** A scenario whose engine echoes every value \`runtime\` is given, once in a \`text\` event and once as the target of a \`tool\` event. */
export interface AgentContractEcho {
    readonly runtime: (values: readonly string[]) => AgentRuntime;
    readonly inputs?: () => readonly AgentRunInput[];
}
/** What the agent contract runs against. \`runtime\`, \`options\` and \`id\` are enough for the plain checks; the rest wires the checks that must see the engine or make it behave in one specific way. A check whose wiring is missing fails and says what to supply. */
export interface AgentContractSubject {
    readonly runtime: (source?: EnvSource) => AgentRuntime;
    readonly options: AgentOptions;
    readonly id: string;
    readonly inputs?: () => readonly AgentRunInput[];
    readonly engine?: AgentEngineImpl<string>;
    readonly cancel?: AgentContractScenario;
    readonly deny?: AgentContractDeny;
    readonly resumeMiss?: AgentContractScenario;
    readonly echo?: AgentContractEcho;
    readonly deadlineMs?: number;
}
/** The checks every agent engine must pass, run through \`subject.runtime()\`: exactly one terminal event and it is last; \`settled\` never rejects and equals the terminal result; cancel ends as cancelled; \`maxTurns\` is required; a cli agent run is refused before anything starts; no secret reaches events, failures or a description, including when the engine echoes the secrets in a text and a tool event; the child env is closed; a deny becomes a refused event with the bare tool name; usage is raw per message and priceless; session events carry id and checkpoint; a resume miss recovers only with a recovery prompt. The same suite runs against the fake engine and against a real one. */
export declare function agentContract(subject: AgentContractSubject): Promise<readonly ContractCheck[]>;

