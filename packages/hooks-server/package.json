{
  "name": "@stateforge-labs/harness-hooks-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The developer hook server: one HTTP endpoint for Claude Code, Codex and OpenCode hooks on a machine, plus the client installers.",
  "license": "MIT",
  "keywords": [
    "claude-code",
    "codex",
    "opencode",
    "hooks",
    "http-server",
    "bun"
  ],
  "homepage": "https://github.com/stateforge-labs/harness-kit/tree/main/packages/hooks-server#readme",
  "bugs": {
    "url": "https://github.com/stateforge-labs/harness-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stateforge-labs/harness-kit.git",
    "directory": "packages/hooks-server"
  },
  "author": "stateforge-labs",
  "engines": {
    "bun": ">=1.4.4"
  },
  "files": [
    "src",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "start": "BUN_OPTIONS=--conditions=stateforge-source bun src/server.ts",
    "install-clients": "BUN_OPTIONS=--conditions=stateforge-source bun scripts/install.ts"
  },
  "dependencies": {
    "@stateforge-labs/harness-hooks": "workspace:*",
    "ipaddr.js": "2.5.0",
    "zod": "4.6.7"
