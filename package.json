{
  "name": "harness-kit",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "gen": "bun --filter @homelab/harness-hooks gen",
    "gen:check": "bun --filter @homelab/harness-hooks gen:check",
    "start": "bun --filter @homelab/harness-hooks-server start",
    "test": "bun tools/check-boundaries.ts && bun test",
    "build": "bun --filter @homelab/harness-hooks build"
  },
  "devDependencies": {
    "@types/bun": "1.4.4"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "workspaces": [
    "packages/*"
  ]
}
