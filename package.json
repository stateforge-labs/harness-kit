{
  "name": "harness-kit",
  "description": "Hook events from Claude Code, Codex and OpenCode in one neutral form, with a middleware pipeline, a hook server and installers.",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "gen": "bun --filter @stateforge-labs/harness-hooks gen",
    "gen:check": "bun --filter @stateforge-labs/harness-hooks gen:check",
    "start": "bun --filter @stateforge-labs/harness-hooks-server start",
    "test": "bun tools/check-boundaries.ts && bun test",
    "build": "bun --filter @stateforge-labs/harness-hooks build"
  },
  "devDependencies": {
    "@types/bun": "1.4.4"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "workspaces": [
    "packages/*"
  ],
  "keywords": [
    "claude-code",
    "codex",
    "opencode",
    "hooks",
    "coding-agent",
    "middleware"
  ],
  "homepage": "https://github.com/stateforge-labs/harness-kit#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/stateforge-labs/harness-kit.git"
  },
  "bugs": {
    "url": "https://github.com/stateforge-labs/harness-kit/issues"
  },
  "author": "stateforge-labs",
  "license": "MIT"
}
