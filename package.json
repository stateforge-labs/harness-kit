{
  "name": "harness-kit",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "gen": "bun --filter @homelab/harness-hooks gen",
    "gen:check": "bun --filter @homelab/harness-hooks gen:check",
    "start": "bun src/server.ts",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "1.4.4"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "ipaddr.js": "2.5.0",
    "@homelab/harness-hooks": "workspace:*",
    "zod": "4.6.7"
  },
  "workspaces": [
    "packages/*"
  ]
}
